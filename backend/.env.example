APP__NAME=trampolin-backend
APP__ENV=development
APP__HOST=127.0.0.1
APP__PORT=8080
APP__LOG_FORMAT=pretty

DATABASE__URL=postgres://postgres:postgres@localhost:5432/trampolin
DATABASE__MAX_CONNECTIONS=10
DATABASE__MIN_CONNECTIONS=1
DATABASE__CONNECT_TIMEOUT_SECS=5

HTTP__BODY_LIMIT_MB=4
HTTP__CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

RUST_LOG=info,tower_http=info,sqlx=warn